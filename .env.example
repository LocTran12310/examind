# Copy to .env and change secrets before exposing the stack.
POSTGRES_USER=examind
POSTGRES_PASSWORD=examind
POSTGRES_DB=examind
MINIO_ROOT_USER=examind
MINIO_ROOT_PASSWORD=examind-secret
S3_BUCKET=examind
JWT_SECRET=change-me-in-production-please-32b
# true once served over HTTPS
COOKIE_SECURE=false
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=admin12345
# Caddy: ":80" for plain HTTP; a domain (examind.example.com) enables automatic HTTPS
SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8448
# Dev machines: also load the port-exposing override
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
